    fi

    # --- Check inbox ---
    MSGS=$(curl -sf "${METADATA}/tapegun/inbox" 2>/dev/null)
    if [ -n "$MSGS" ] && [ "$MSGS" != "[]" ] && [ "$MSGS" != "null" ]; then
        # Append to inbox file (create if missing)
        if [ -f "$INBOX_FILE" ]; then
            # Merge new messages into existing array
            if command -v jq >/dev/null 2>&1; then
                jq -s '.[0] + .[1]' "$INBOX_FILE" <(echo "$MSGS") > "${INBOX_FILE}.tmp" \
                    && mv "${INBOX_FILE}.tmp" "$INBOX_FILE"
            else
                echo "$MSGS" > "$INBOX_FILE"
            fi
        else
            echo "$MSGS" > "$INBOX_FILE"
        fi
        chmod 644 "$INBOX_FILE"

        # Inject send_keys messages into tmux.
        # By default, Enter is sent after the text (auto-submit).
        # Messages with no_enter=true paste text without pressing Enter.
        if command -v jq >/dev/null 2>&1 && $TMUX_CMD has-session 2>/dev/null; then
            echo "$MSGS" | jq -c '.[] | select(.send_keys == true or .priority == "urgent")' | while IFS= read -r msg_obj; do
                line=$(echo "$msg_obj" | jq -r '.body')
                no_enter=$(echo "$msg_obj" | jq -r '.no_enter // false')
                if [ -n "$line" ]; then
                    opencode_send_message "$line" "$no_enter"
                fi
            done
        fi
    fi

    # --- Check orchestrator message queue and dispatch tasks ---
    ORCH_QUEUE="${BOXCUTTER_QUEUE:-$(hostname).inbox}"
    ORCH_URL="${BOXCUTTER_ORCHESTRATOR:-http://192.168.50.2:8801}"
    queue_response=$(curl -sf "${ORCH_URL}/api/queues/${ORCH_QUEUE}/messages" --max-time 3 2>/dev/null)
    if [ -n "$queue_response" ] && [ "$queue_response" != "[]" ] && [ "$queue_response" != "null" ]; then
        q_count=$(echo "$queue_response" | jq 'length' 2>/dev/null)
        if [ "${q_count:-0}" -gt 0 ]; then
            # Ack immediately
            curl -sf -X POST "${ORCH_URL}/api/queues/${ORCH_QUEUE}/ack" \
                -H "Content-Type: application/json" \
                -d "{\"message_ids\":[$(echo "$queue_response" | jq -r '[.[].id | "\"" + . + "\""] | join(",")')]}" \
                --max-time 2 2>/dev/null || true

            combined_msg=$(echo "$queue_response" | jq -r '.[] | "[from \(.from_agent // "unknown")] \(.body)"' 2>/dev/null)

            # Pre-task: sync to latest master so agents work on current code
            _tq_workdir="${CLAUDE_WORKING_DIR:-$PROJECT_DIR}"
            if [ -d "$_tq_workdir/.git" ]; then
                (cd "$_tq_workdir" && git stash 2>/dev/null; git checkout master 2>/dev/null; git pull --ff-only 2>/dev/null) && \
                    log "synced to latest master before task" || \
                    log "WARNING: git sync failed, proceeding with current state"

                # Create a task branch so the agent's work is isolated
                _tq_branch="agent/$(hostname)/$(date +%s)"
                (cd "$_tq_workdir" && git checkout -b "$_tq_branch" 2>/dev/null) && \
                    log "created branch $_tq_branch" || true
            fi

            # Wrap the user's message with workflow instructions
            task_prompt="$combined_msg

IMPORTANT WORKFLOW: When you finish the task above:
1. Stage and commit your changes with a clear commit message
2. Push your branch: git push origin HEAD
3. Create a PR: gh pr create --title '<short title>' --body '<what you did and why>'
Report the PR URL when done."

            # Dispatch task to the coding agent
            case "$AGENT_TOOL" in
              claude-code)
                # Run Claude Code headlessly — avoids interactive API key prompts
                _claude_bin="$HOME/.local/bin/claude"
                [ ! -x "$_claude_bin" ] && _claude_bin="$(which claude 2>/dev/null || echo claude)"
                ([ -f "$HOME/.claude_env" ] && . "$HOME/.claude_env"; cd "$_tq_workdir" && PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH" "$_claude_bin" -p --dangerously-skip-permissions "$task_prompt" > /tmp/claude-task-output.log 2>&1) &
                log "dispatched task to Claude Code headless (branch, $q_count msg)"
                ;;
              opencode)
                # OpenCode server API
                if curl -sf -u "opencode:${OPENCODE_SERVER_PASSWORD:-tapegun}" "http://localhost:${OPENCODE_SERVER_PORT:-4096}/session" --max-time 1 >/dev/null 2>&1; then
                    oc_session=$(curl -sf -u "opencode:${OPENCODE_SERVER_PASSWORD:-tapegun}" "http://localhost:${OPENCODE_SERVER_PORT:-4096}/session" --max-time 2 2>/dev/null | jq -r '.[0].id // empty')
                    if [ -z "$oc_session" ]; then
                        oc_session=$(curl -sf -u "opencode:${OPENCODE_SERVER_PASSWORD:-tapegun}" -X POST "http://localhost:${OPENCODE_SERVER_PORT:-4096}/session" \
                            -H "Content-Type: application/json" -d '{}' --max-time 3 2>/dev/null | jq -r '.id // empty')
                    fi
                    if [ -n "$oc_session" ]; then
                        oc_payload=$(jq -n --arg text "$task_prompt" '{parts: [{type: "text", text: $text}]}')
                        curl -sf -u "opencode:${OPENCODE_SERVER_PASSWORD:-tapegun}" \
                            -X POST "http://localhost:${OPENCODE_SERVER_PORT:-4096}/session/${oc_session}/message" \
                            -H "Content-Type: application/json" \
                            -d "$oc_payload" \
                            --max-time 120 >/dev/null 2>&1 &
                        log "dispatched task to OpenCode (branch, $q_count msg)"
                    fi
                fi
                ;;
              *)
                # Fallback: inject into tmux
                if $TMUX_CMD has-session 2>/dev/null; then
                    opencode_send_message "$task_prompt" "false"
                fi
                ;;
            esac
        fi
    fi

    # --- CI status polling (every 30s = every 6th cycle) ---
    CI_POLL_COUNTER=$((CI_POLL_COUNTER + 1))
    if [ $((CI_POLL_COUNTER % 6)) -eq 0 ] && command -v gh >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        check_ci_status
    fi

    # --- Token usage metrics (every 5min = every 60th cycle) ---
    METRICS_POLL_COUNTER=$((METRICS_POLL_COUNTER + 1))
    if [ $((METRICS_POLL_COUNTER % 60)) -eq 0 ] && command -v jq >/dev/null 2>&1; then
        compute_token_usage
    fi

    # --- Crash detection & auto-restart ---
    # Skip for headless queue-driven mode — tasks are dispatched via claude -p,
    # not a persistent interactive session.
    if [ "$AUTOSTART_CLAUDE" = "true" ] && ! ([ "$AGENT_TOOL" = "claude-code" ] && [ "$_has_headless_auth" = "true" ]); then
        case "$AGENT_TOOL" in
          opencode) AGENT_PROC_PATTERN='opencode' ;;
          aider)    AGENT_PROC_PATTERN='aider' ;;
          *)        AGENT_PROC_PATTERN='claude' ;;
        esac

        if ! $TMUX_CMD has-session -t main 2>/dev/null; then
            log "tmux session 'main' gone, restarting $AGENT_TOOL"
            $TMUX_CMD new-session -d -s main
            sleep 1
            $TMUX_CMD send-keys -t main 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' Enter
            $TMUX_CMD send-keys -t main '[ -f ~/.claude_env ] && source ~/.claude_env' Enter
            sleep 0.5
            if [ -n "$CLAUDE_WORKING_DIR" ] && [ -d "$CLAUDE_WORKING_DIR" ]; then
                $TMUX_CMD send-keys -t main "cd $CLAUDE_WORKING_DIR" Enter
                sleep 0.5
            fi
            launch_agent_tool
            log "$AGENT_TOOL restarted (session recreated)"
        elif ! pgrep -f "$AGENT_PROC_PATTERN" -u "$(id -u)" >/dev/null 2>&1; then
            log "$AGENT_TOOL process not found, restarting"
            launch_agent_tool
            log "$AGENT_TOOL restarted (in existing session)"
        fi
    fi

    sleep "$POLL_INTERVAL"
done
