#!/bin/bash
# Tapegun agent communication daemon.
# Periodically captures tmux pane content and posts it to the metadata service.
# Checks for incoming messages and writes them to the inbox file.
# Messages with send_keys=true are also injected into tmux.
#
# Setup phase (issue #94): reads agent-config from metadata and realizes the
# workspace (repo wait, persona files, Claude Code settings) before launching
# Claude Code.  This replaces the former boxcutter-boot-agent service — tapegun
# is the single agent supervisor.

METADATA="http://169.254.169.254"
INBOX_DIR="/home/dev/.tapegun"
INBOX_FILE="${INBOX_DIR}/inbox.json"
CONFIG_FILE="${INBOX_DIR}/config"
POLL_INTERVAL=5

HOME_DIR="/home/dev"
PROJECT_DIR="${HOME_DIR}/project"
CLAUDE_DIR="${HOME_DIR}/.claude"
SETUP_STAMP="${HOME_DIR}/.tapegun-setup-done"

mkdir -p "$INBOX_DIR"

# --- Stop hook: notify metadata service on shutdown ---
cleanup() {
    echo "tapegun: shutting down, posting final status"
    curl -sf -X POST "${METADATA}/tapegun/activity" \
        -H "Content-Type: application/json" \
        -d '{"pane_content":"","status":"stopped"}' \
        --max-time 2 2>/dev/null || true
    exit 0
}
trap cleanup SIGTERM SIGINT

# --- Auto-start Claude Code under tmux ---
# Enabled by default (issue #62). Override via config file or metadata labels.
# Config file: /home/dev/.tapegun/config
# AUTOSTART_CLAUDE=false  # set to false to disable
# CLAUDE_FLAGS="--dangerously-skip-permissions"
# CLAUDE_RESUME=false
# CLAUDE_WORKING_DIR="/home/dev/project"
AUTOSTART_CLAUDE=true
CLAUDE_FLAGS="--dangerously-skip-permissions"
CLAUDE_RESUME=false
CLAUDE_WORKING_DIR="/home/dev/project"

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Also check metadata labels for autostart config (labels override defaults)
LABELS=$(curl -sf --max-time 2 "${METADATA}/identity" 2>/dev/null | jq -r '.labels // {} | to_entries[] | "\(.key)=\(.value)"' 2>/dev/null)
if echo "$LABELS" | grep -q "tapegun.autostart=false"; then
    AUTOSTART_CLAUDE=false
elif echo "$LABELS" | grep -q "tapegun.autostart=true"; then
    AUTOSTART_CLAUDE=true
fi
if echo "$LABELS" | grep -q "tapegun.resume=true"; then
    CLAUDE_RESUME=true
fi

# =============================================================================
# Setup phase: read agent-config from metadata, realize workspace.
# Runs once per boot (idempotent via stamp file).  On 404/empty config the
# phase is skipped and tapegun falls through to existing behaviour.
# =============================================================================

log() { echo "tapegun: $*"; }

setup_git_credentials() {
    local resp token
    resp=$(curl -sf --max-time 5 "${METADATA}/token/github" 2>/dev/null || echo "")
    token=$(echo "$resp" | jq -r '.token // empty' 2>/dev/null)
    if [ -n "$token" ]; then
        git config --global credential.helper \
            '!f() { echo "username=x-access-token"; echo "password='"$token"'"; }; f'
        log "git credentials configured"
    else
        log "WARNING: no GitHub token available, clones may fail"
    fi
}

clone_repo() {
    local repo="$1" target_dir="$2"
    if [ -d "$target_dir/.git" ]; then
        log "repo $repo already cloned at $target_dir, pulling latest"
        git -C "$target_dir" pull --ff-only 2>/dev/null || true
        return 0
    fi
    log "cloning $repo -> $target_dir"
    mkdir -p "$(dirname "$target_dir")"
    if git clone "https://github.com/${repo}.git" "$target_dir" 2>&1; then
        git -C "$target_dir" remote set-url origin "https://github.com/${repo}.git"
        log "cloned $repo"
    else
        log "WARNING: failed to clone $repo"
        return 1
    fi
}

install_persona() {
    local working_dir="$1"
    local persona_claude_md="$2"
    local persona_instructions="$3"
    local team_persona_files="$4"

    [ ! -d "$working_dir" ] && return

    local personas_dir="${working_dir}/.claude/personas"

    # Install persona file from repo path (e.g. ".claude/personas/dev.md")
    if [ -n "$persona_claude_md" ]; then
        local src="${working_dir}/${persona_claude_md}"
        if [ -f "$src" ]; then
            # Append inline instructions to the persona file if provided
            if [ -n "$persona_instructions" ]; then
                printf '\n\n## Additional Instructions\n\n%s\n' "$persona_instructions" >> "$src"
                log "appended inline instructions to $persona_claude_md"
            fi
            log "persona file verified at $persona_claude_md"
        else
            # Persona file doesn't exist yet — create it at the specified path
            mkdir -p "$(dirname "$src")"
            if [ -n "$persona_instructions" ]; then
                printf '# Agent Instructions\n\n%s\n' "$persona_instructions" > "$src"
            else
                touch "$src"
            fi
            log "created persona file at $persona_claude_md"
        fi
    elif [ -n "$persona_instructions" ]; then
        # No persona file path — create a default persona file
        mkdir -p "$personas_dir"
        printf '# Agent Instructions\n\n%s\n' "$persona_instructions" > "${personas_dir}/agent.md"
        log "created default persona at .claude/personas/agent.md"
    fi

    # Remove other agents' persona files (only files listed in team_persona_files)
    if [ -n "$team_persona_files" ]; then
        echo "$team_persona_files" | while IFS= read -r file; do
            [ -z "$file" ] && continue
            # Skip this agent's own persona file
            [ "$file" = "$persona_claude_md" ] && continue
            local target="${working_dir}/${file}"
            if [ -f "$target" ]; then
                rm "$target"
                log "removed other agent's persona: $file"
            fi
        done
    fi
}

setup_workspace() {
    # Idempotency: skip if already completed this boot
    if [ -f "$SETUP_STAMP" ]; then
        log "setup already completed this boot, skipping"
        return 0
    fi

    # Fetch agent config
    local agent_config
    agent_config=$(curl -sf --max-time 5 "${METADATA}/metadata/agent-config" 2>/dev/null || echo "")
    if [ -z "$agent_config" ] || [ "$agent_config" = "null" ] || [ "$agent_config" = "{}" ]; then
        log "no agent-config available, using defaults"
        touch "$SETUP_STAMP"
        return 0
    fi

    log "agent config received"

    # Parse config fields
    local repos persona_claude_md persona_instructions claude_flags claude_resume working_dir team_persona_files
    repos=$(echo "$agent_config" | jq -r '.repos // [] | .[]' 2>/dev/null)
    persona_claude_md=$(echo "$agent_config" | jq -r '.persona.claude_md // empty' 2>/dev/null)
    persona_instructions=$(echo "$agent_config" | jq -r '.persona.instructions // empty' 2>/dev/null)
    claude_flags=$(echo "$agent_config" | jq -r '.claude_flags // empty' 2>/dev/null)
    claude_resume=$(echo "$agent_config" | jq -r '.claude_resume // empty' 2>/dev/null)
    working_dir=$(echo "$agent_config" | jq -r '.working_dir // empty' 2>/dev/null)
    team_persona_files=$(echo "$agent_config" | jq -r '.team_persona_files // [] | .[]' 2>/dev/null)

    local repo_count
    repo_count=$(echo "$repos" | grep -c . || true)

    # Clone repos if specified
    if [ "$repo_count" -gt 0 ]; then
        setup_git_credentials

        if [ "$repo_count" -eq 1 ]; then
            local repo
            repo=$(echo "$repos" | head -1)
            clone_repo "$repo" "$PROJECT_DIR"
            [ -z "$working_dir" ] && working_dir="$PROJECT_DIR"
        else
            local first_repo=""
            while IFS= read -r repo; do
                [ -z "$repo" ] && continue
                local repo_name
                repo_name=$(basename "$repo")
                clone_repo "$repo" "${HOME_DIR}/projects/${repo_name}"
                [ -z "$first_repo" ] && first_repo="${HOME_DIR}/projects/${repo_name}"
            done <<< "$repos"
            if [ -n "$first_repo" ] && [ ! -e "$PROJECT_DIR" ]; then
                ln -sf "$first_repo" "$PROJECT_DIR"
                log "symlinked ~/project -> $first_repo"
            fi
            [ -z "$working_dir" ] && working_dir="$first_repo"
        fi
    fi

    # Wait for working directory (repo clone may be in progress from orchestrator)
    local target_dir="${working_dir:-$PROJECT_DIR}"
    if [ -n "$target_dir" ] && [ ! -d "$target_dir" ]; then
        log "waiting for $target_dir to appear..."
        for _i in $(seq 1 30); do
            [ -d "$target_dir" ] && break
            sleep 2
        done
    fi

    # Install persona files at .claude/personas/ path
    install_persona "$target_dir" "$persona_claude_md" "$persona_instructions" "$team_persona_files"

    # Update tapegun config variables for Claude Code launch
    [ -n "$claude_flags" ] && CLAUDE_FLAGS="$claude_flags"
    [ -n "$claude_resume" ] && CLAUDE_RESUME="$claude_resume"
    [ -n "$working_dir" ] && CLAUDE_WORKING_DIR="$working_dir"

    # Pre-trust the working directory
    local settings_file="${CLAUDE_DIR}/settings.json"
    mkdir -p "$CLAUDE_DIR"
    if [ ! -f "$settings_file" ]; then
        cat > "$settings_file" <<EOSETTINGS
{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "trustedDirectories": [
    "${working_dir:-$PROJECT_DIR}"
  ]
}
EOSETTINGS
        log "pre-trusted directory ${working_dir:-$PROJECT_DIR}"
    fi

    touch "$SETUP_STAMP"
    log "workspace setup complete"
}

setup_workspace

# =============================================================================
# Claude Code auto-start
# =============================================================================

if [ "$AUTOSTART_CLAUDE" = "true" ]; then
    echo "tapegun: auto-starting Claude Code under tmux"

    # Pre-trust the working directory so Claude doesn't prompt on first launch.
    # The --dangerously-skip-permissions flag handles tool permissions, but
    # Claude still prompts to trust the project directory on first use.
    if [ -n "$CLAUDE_WORKING_DIR" ]; then
        TRUST_DIR="$HOME/.claude"
        mkdir -p "$TRUST_DIR"
        # Write settings that pre-trust the working directory
        SETTINGS_FILE="$TRUST_DIR/settings.json"
        if [ ! -f "$SETTINGS_FILE" ]; then
            cat > "$SETTINGS_FILE" <<EOSETTINGS
{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "trustedDirectories": [
    "$CLAUDE_WORKING_DIR"
  ]
}
EOSETTINGS
            echo "tapegun: pre-trusted directory $CLAUDE_WORKING_DIR"
        fi
    fi

    # Create tmux session if not exists
    if ! tmux has-session -t main 2>/dev/null; then
        tmux new-session -d -s main
        sleep 1

        # Ensure PATH includes ~/.local/bin (where claude is installed via mise)
        tmux send-keys -t main 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' Enter
        sleep 0.5

        # Wait for working directory to appear (repo clone may still be in progress).
        # Polls every 2s for up to 30s, then proceeds without it.
        if [ -n "$CLAUDE_WORKING_DIR" ] && [ ! -d "$CLAUDE_WORKING_DIR" ]; then
            echo "tapegun: waiting for $CLAUDE_WORKING_DIR to appear..."
            for _i in $(seq 1 15); do
                [ -d "$CLAUDE_WORKING_DIR" ] && break
                sleep 2
            done
        fi

        if [ -n "$CLAUDE_WORKING_DIR" ] && [ -d "$CLAUDE_WORKING_DIR" ]; then
            tmux send-keys -t main "cd $CLAUDE_WORKING_DIR" Enter
            sleep 0.5
        fi

        # Install tapegun-guest plugin so inbox, stop notifications, and
        # status reporting hooks are active in the Claude Code session.
        PLUGIN_DIR="$HOME/.claude/plugins/tapegun-guest"
        if [ -d "$PLUGIN_DIR" ]; then
            tmux send-keys -t main "claude plugin install $PLUGIN_DIR 2>/dev/null" Enter
            sleep 2
            echo "tapegun: installed tapegun-guest plugin"
        else
            echo "tapegun: WARNING: plugin not found at $PLUGIN_DIR"
        fi

        # Start Claude Code
        CLAUDE_CMD="claude"
        [ -n "$CLAUDE_FLAGS" ] && CLAUDE_CMD="$CLAUDE_CMD $CLAUDE_FLAGS"
        [ "$CLAUDE_RESUME" = "true" ] && CLAUDE_CMD="$CLAUDE_CMD --resume"
        tmux send-keys -t main "$CLAUDE_CMD" Enter
        echo "tapegun: Claude Code started (flags: $CLAUDE_FLAGS, resume: $CLAUDE_RESUME)"
    else
        echo "tapegun: tmux session 'main' already exists, skipping autostart"
    fi
fi

# Wait for metadata service
for i in $(seq 1 30); do
  if curl -sf -o /dev/null --max-time 2 "${METADATA}/identity" 2>/dev/null; then
    break
  fi
  [ "$i" -eq 30 ] && { echo "tapegun: metadata service not reachable"; exit 1; }
  sleep 1
done

echo "tapegun: daemon started (poll every ${POLL_INTERVAL}s)"

# tmux command -- runs as the dev user (service runs as User=dev)
TMUX_CMD="tmux"

# --- Health check function ---
run_health_checks() {
    local binary_exec=false
    local network=false
    local metadata=false
    local disk=false
    local services=false
    local health="unhealthy"
    local details=""

    # Check 1: binary execution
    if /bin/true 2>/dev/null; then
        binary_exec=true
    fi

    # Check 2: network connectivity (gateway)
    if ping -c1 -W2 10.0.0.1 >/dev/null 2>&1; then
        network=true
    fi

    # Check 3: metadata service reachable
    if curl -sf --max-time 2 "${METADATA}/identity" >/dev/null 2>&1; then
        metadata=true
    fi

    # Check 4: disk readable
    if test -r /etc/os-release 2>/dev/null; then
        disk=true
    fi

    # Check 5: key services running (ssh, tapegun -- tapegun is us, so just ssh)
    if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
        services=true
    fi

    # Determine overall health
    if $binary_exec && $network && $metadata && $disk && $services; then
        health="healthy"
    elif $binary_exec && $disk; then
        health="degraded"
    fi

    # Build JSON
    if command -v jq >/dev/null 2>&1; then
        jq -n \
            --arg health "$health" \
            --argjson binary_exec "$binary_exec" \
            --argjson network "$network" \
            --argjson metadata "$metadata" \
            --argjson disk "$disk" \
            --argjson services "$services" \
            '{health: $health, health_checks: {binary_exec: $binary_exec, network: $network, metadata: $metadata, disk: $disk, services: $services}}'
    else
        cat <<EOJSON
{"health":"${health}","health_checks":{"binary_exec":${binary_exec},"network":${network},"metadata":${metadata},"disk":${disk},"services":${services}}}
EOJSON
    fi
}

while true; do
    # --- Post health ---
    HEALTH_PAYLOAD=$(run_health_checks)
    curl -sf -X POST "${METADATA}/tapegun/health" \
        -H "Content-Type: application/json" \
        -d "$HEALTH_PAYLOAD" \
        2>/dev/null || true

    # --- Post activity ---
    if $TMUX_CMD has-session 2>/dev/null; then
        PANE_CONTENT=$($TMUX_CMD capture-pane -p -t 0 2>/dev/null | tail -50)
        if [ -n "$PANE_CONTENT" ]; then
            STATUS="active"
        else
            STATUS="idle"
        fi
        # Build JSON payload -- use jq for safe escaping
        if command -v jq >/dev/null 2>&1; then
            PAYLOAD=$(jq -n \
                --arg content "$PANE_CONTENT" \
                --arg status "$STATUS" \
                '{pane_content: $content, status: $status}')
        else
            # Fallback: Python for JSON escaping
            PAYLOAD=$(python3 -c "
import json, sys
print(json.dumps({'pane_content': sys.stdin.read(), 'status': '$STATUS'}))" <<< "$PANE_CONTENT")
        fi
        curl -sf -X POST "${METADATA}/tapegun/activity" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD" \
            2>/dev/null || true
    fi

    # --- Check inbox ---
    MSGS=$(curl -sf "${METADATA}/tapegun/inbox" 2>/dev/null)
    if [ -n "$MSGS" ] && [ "$MSGS" != "[]" ] && [ "$MSGS" != "null" ]; then
        # Append to inbox file (create if missing)
        if [ -f "$INBOX_FILE" ]; then
            # Merge new messages into existing array
            if command -v jq >/dev/null 2>&1; then
                jq -s '.[0] + .[1]' "$INBOX_FILE" <(echo "$MSGS") > "${INBOX_FILE}.tmp" \
                    && mv "${INBOX_FILE}.tmp" "$INBOX_FILE"
            else
                echo "$MSGS" > "$INBOX_FILE"
            fi
        else
            echo "$MSGS" > "$INBOX_FILE"
        fi
        chmod 644 "$INBOX_FILE"

        # Inject send_keys messages into tmux.
        # By default, Enter is sent after the text (auto-submit).
        # Messages with no_enter=true paste text without pressing Enter.
        if command -v jq >/dev/null 2>&1 && $TMUX_CMD has-session 2>/dev/null; then
            echo "$MSGS" | jq -c '.[] | select(.send_keys == true or .priority == "urgent")' | while IFS= read -r msg_obj; do
                line=$(echo "$msg_obj" | jq -r '.body')
                no_enter=$(echo "$msg_obj" | jq -r '.no_enter // false')
                if [ -n "$line" ]; then
                    if [ "$no_enter" = "true" ]; then
                        $TMUX_CMD send-keys -t 0 "$line"
                    else
                        $TMUX_CMD send-keys -t 0 "$line" Enter
                    fi
                fi
            done
        fi
    fi

    # --- Crash detection & auto-restart ---
    # If autostart is enabled, ensure tmux session and Claude Code stay alive.
    if [ "$AUTOSTART_CLAUDE" = "true" ]; then
        if ! $TMUX_CMD has-session -t main 2>/dev/null; then
            # Session gone entirely — recreate and relaunch
            echo "tapegun: tmux session 'main' gone, restarting"
            $TMUX_CMD new-session -d -s main
            sleep 1
            $TMUX_CMD send-keys -t main 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' Enter
            sleep 0.5
            if [ -n "$CLAUDE_WORKING_DIR" ] && [ -d "$CLAUDE_WORKING_DIR" ]; then
                $TMUX_CMD send-keys -t main "cd $CLAUDE_WORKING_DIR" Enter
                sleep 0.5
            fi
            CLAUDE_CMD="claude"
            [ -n "$CLAUDE_FLAGS" ] && CLAUDE_CMD="$CLAUDE_CMD $CLAUDE_FLAGS"
            [ "$CLAUDE_RESUME" = "true" ] && CLAUDE_CMD="$CLAUDE_CMD --resume"
            $TMUX_CMD send-keys -t main "$CLAUDE_CMD" Enter
            echo "tapegun: Claude Code restarted (session recreated)"
        elif ! pgrep -f 'claude' -u "$(id -u)" >/dev/null 2>&1; then
            # Session exists but Claude Code process died — relaunch in existing session
            echo "tapegun: Claude Code process not found, restarting"
            CLAUDE_CMD="claude"
            [ -n "$CLAUDE_FLAGS" ] && CLAUDE_CMD="$CLAUDE_CMD $CLAUDE_FLAGS"
            [ "$CLAUDE_RESUME" = "true" ] && CLAUDE_CMD="$CLAUDE_CMD --resume"
            $TMUX_CMD send-keys -t main "$CLAUDE_CMD" Enter
            echo "tapegun: Claude Code restarted (in existing session)"
        fi
    fi

    sleep "$POLL_INTERVAL"
done
