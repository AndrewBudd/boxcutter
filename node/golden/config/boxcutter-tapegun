#!/bin/bash
# Tapegun agent communication daemon.
# Periodically captures tmux pane content and posts it to the metadata service.
# Checks for incoming messages and writes them to the inbox file.
# Messages with send_keys=true are also injected into tmux.
#
# Setup phase (issue #94): reads agent-config from metadata and realizes the
# workspace (repo wait, persona files, Claude Code settings) before launching
# Claude Code.  This replaces the former boxcutter-boot-agent service — tapegun
# is the single agent supervisor.

METADATA="http://169.254.169.254"
INBOX_DIR="/home/dev/.tapegun"
INBOX_FILE="${INBOX_DIR}/inbox.json"
CONFIG_FILE="${INBOX_DIR}/config"
POLL_INTERVAL=5
INFERENCE_ENDPOINT="http://192.168.50.1:11430/v1"
INFERENCE_API_KEY="dummy"
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_PASSWORD="tapegun"

HOME_DIR="/home/dev"
PROJECT_DIR="${HOME_DIR}/project"
CLAUDE_DIR="${HOME_DIR}/.claude"
SETUP_STAMP="${HOME_DIR}/.tapegun-setup-done"
CHECKPOINT_INTERVAL=60
LAST_CHECKPOINT=0
RESTORED_SESSION_ID=""
TAPEGUN_SEQUENCES=""
SEQUENCES_EXECUTED=false

mkdir -p "$INBOX_DIR"

# --- Stop hook: notify metadata service on shutdown ---
cleanup() {
    echo "tapegun: shutting down, posting final checkpoint and status"
    checkpoint_session 2>/dev/null || true
    curl -sf -X POST "${METADATA}/tapegun/activity" \
        -H "Content-Type: application/json" \
        -d '{"pane_content":"","status":"stopped"}' \
        --max-time 2 2>/dev/null || true
    exit 0
}
trap cleanup SIGTERM SIGINT

# --- Auto-start Claude Code under tmux ---
# Enabled by default (issue #62). Override via config file or metadata labels.
# Config file: /home/dev/.tapegun/config
# AUTOSTART_CLAUDE=false  # set to false to disable
# CLAUDE_FLAGS="--dangerously-skip-permissions"
# CLAUDE_RESUME=false
# CLAUDE_WORKING_DIR="/home/dev/project"
AUTOSTART_CLAUDE=true
CLAUDE_FLAGS="--dangerously-skip-permissions"
CLAUDE_RESUME=false
CLAUDE_WORKING_DIR="/home/dev/project"
AGENT_TOOL="claude-code"
AGENT_MODEL=""
CLAUDE_AUTH=""
CLAUDE_OAUTH_TOKEN=""
CLAUDE_API_KEY=""

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Also check metadata labels for autostart config (labels override defaults)
LABELS=$(curl -sf --max-time 2 "${METADATA}/identity" 2>/dev/null | jq -r '.labels // {} | to_entries[] | "\(.key)=\(.value)"' 2>/dev/null)
if echo "$LABELS" | grep -q "tapegun.autostart=false"; then
    AUTOSTART_CLAUDE=false
elif echo "$LABELS" | grep -q "tapegun.autostart=true"; then
    AUTOSTART_CLAUDE=true
fi
if echo "$LABELS" | grep -q "tapegun.resume=true"; then
    CLAUDE_RESUME=true
fi

# =============================================================================
# Setup phase: read agent-config from metadata, realize workspace.
# Runs once per boot (idempotent via stamp file).  On 404/empty config the
# phase is skipped and tapegun falls through to existing behaviour.
# =============================================================================

log() { echo "tapegun: $*"; }

# Install Claude Code plugins from agent config.
# Adds marketplaces first, then installs plugins.
install_plugins() {
    local marketplaces="$1"
    local plugins="$2"
    local claude_bin="$HOME/.local/bin/claude"
    [ ! -x "$claude_bin" ] && claude_bin="$(which claude 2>/dev/null || echo "")"
    [ -z "$claude_bin" ] && { log "WARNING: claude not found, skipping plugin install"; return; }

    # Add marketplaces
    if [ -n "$marketplaces" ]; then
        while IFS= read -r marketplace; do
            [ -z "$marketplace" ] && continue
            log "adding marketplace: $marketplace"
            "$claude_bin" plugin marketplace add "$marketplace" 2>/dev/null || \
                log "WARNING: failed to add marketplace $marketplace"
        done <<< "$marketplaces"
    fi

    # Install plugins
    if [ -n "$plugins" ]; then
        while IFS= read -r plugin; do
            [ -z "$plugin" ] && continue
            log "installing plugin: $plugin"
            "$claude_bin" plugin install "$plugin" 2>/dev/null || \
                log "WARNING: failed to install plugin $plugin"
        done <<< "$plugins"
        log "plugin installation complete"
    fi
}

# Launch the configured agent tool in the current tmux session.
# Assumes tmux session 'main' exists and is cd'd to the working directory.
launch_agent_tool() {
    case "$AGENT_TOOL" in
      claude-code)
        CLAUDE_CMD="claude"
        [ -n "$CLAUDE_FLAGS" ] && CLAUDE_CMD="$CLAUDE_CMD $CLAUDE_FLAGS"
        if [ -n "$RESTORED_SESSION_ID" ]; then
            CLAUDE_CMD="$CLAUDE_CMD --continue"
        elif [ "$CLAUDE_RESUME" = "true" ]; then
            CLAUDE_CMD="$CLAUDE_CMD --resume"
        fi
        $TMUX_CMD send-keys -t main "$CLAUDE_CMD" Enter
        ;;
      opencode)
        local provider_id="${INFERENCE_PROVIDER:-local}"
        local provider_name="Inference"
        local base_url="${INFERENCE_ENDPOINT}"

        case "$provider_id" in
          openrouter)
            provider_name="OpenRouter"
            base_url="${INFERENCE_ENDPOINT:-https://openrouter.ai/api/v1}"
            ;;
          local|*)
            provider_name="Local Ollama"
            base_url="${INFERENCE_ENDPOINT:-http://192.168.50.1:11430/v1}"
            ;;
        esac

        local workdir="${CLAUDE_WORKING_DIR:-$PROJECT_DIR}"
        local oc_config="${workdir}/opencode.json"
        cat > "$oc_config" <<OCJSON
{
  "provider": {
    "${provider_id}": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "${provider_name}",
      "options": {
        "baseURL": "${base_url}",
        "apiKey": "${INFERENCE_API_KEY}"
      },
      "models": {
        "${AGENT_MODEL}": {
          "name": "${AGENT_MODEL}"
        }
      }
    }
  },
  "model": "${provider_id}/${AGENT_MODEL}",
  "permission": {
    "*": "allow",
    "doom_loop": "allow",
    "external_directory": "allow",
    "read": { "*": "allow", "*.env": "allow", "*.env.*": "allow" },
    "write": { "*": "allow" },
    "bash": { "*": "allow" }
  }
}
OCJSON
        chown 1000:1000 "$oc_config" 2>/dev/null || true

        $TMUX_CMD send-keys -t main "export OPENAI_BASE_URL='${base_url}'" Enter
        $TMUX_CMD send-keys -t main "export OPENAI_API_KEY='${INFERENCE_API_KEY}'" Enter
        sleep 0.5
        $TMUX_CMD send-keys -t main "OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD} opencode serve --port ${OPENCODE_SERVER_PORT} --hostname 0.0.0.0" Enter
        ;;
      aider)
        $TMUX_CMD send-keys -t main "export OPENAI_API_BASE='http://169.254.169.254/v1'" Enter
        $TMUX_CMD send-keys -t main "export OPENAI_API_KEY='dummy'" Enter
        sleep 0.5
        $TMUX_CMD send-keys -t main "aider --model openai/${AGENT_MODEL} --yes" Enter
        ;;
      *)
        log "WARNING: unknown agent tool '$AGENT_TOOL', falling back to claude-code"
        AGENT_TOOL="claude-code"
        $TMUX_CMD send-keys -t main "claude ${CLAUDE_FLAGS}" Enter
        ;;
    esac
}

setup_git_credentials() {
    local resp token
    resp=$(curl -sf --max-time 5 "${METADATA}/token/github" 2>/dev/null || echo "")
    token=$(echo "$resp" | jq -r '.token // empty' 2>/dev/null)
    if [ -n "$token" ]; then
        git config --global credential.helper \
            '!f() { echo "username=x-access-token"; echo "password='"$token"'"; }; f'
        # Also authenticate gh CLI so `gh auth status` works
        echo "$token" | gh auth login --with-token 2>/dev/null || true
        log "git + gh credentials configured"
    else
        log "WARNING: no GitHub token available, clones may fail"
    fi
}

setup_claude_credentials() {
    # Skip entirely if not using claude-code and no explicit auth configured
    # EXCEPT: if using claude-code with an inference provider (e.g. openrouter),
    # we can route Claude Code through that provider's API.
    if [ "${AGENT_TOOL:-claude-code}" != "claude-code" ] && [ -z "${CLAUDE_AUTH:-}" ]; then
        return 0
    fi

    local cred_file="${CLAUDE_DIR}/.credentials.json"
    mkdir -p "$CLAUDE_DIR"

    # Method 0: Inference provider routing — use OpenRouter/other provider as Claude backend
    # When tool=claude-code and inference.provider=openrouter, route Claude Code
    # through OpenRouter's Anthropic-compatible API.
    if [ "${AGENT_TOOL:-}" = "claude-code" ] && [ -z "${CLAUDE_AUTH:-}" ] && [ -n "${INFERENCE_API_KEY:-}" ]; then
        local envfile="/home/dev/.claude_env"
        case "${INFERENCE_PROVIDER:-}" in
          openrouter)
            printf 'export ANTHROPIC_API_KEY="%s"\nexport ANTHROPIC_BASE_URL="https://openrouter.ai/api"\n' "$INFERENCE_API_KEY" > "$envfile"
            log "Claude Code configured via OpenRouter (ANTHROPIC_BASE_URL)"
            ;;
          *)
            if [ -n "${INFERENCE_ENDPOINT:-}" ]; then
                printf 'export ANTHROPIC_API_KEY="%s"\nexport ANTHROPIC_BASE_URL="%s"\n' "$INFERENCE_API_KEY" "$INFERENCE_ENDPOINT" > "$envfile"
                log "Claude Code configured via custom endpoint ($INFERENCE_ENDPOINT)"
            fi
            ;;
        esac
        if [ -f "$envfile" ]; then
            chmod 600 "$envfile"
            if ! grep -q 'source.*\.claude_env' /home/dev/.bashrc 2>/dev/null; then
                printf '\n[ -f ~/.claude_env ] && source ~/.claude_env\n' >> /home/dev/.bashrc
            fi
            return 0
        fi
    fi

    # Method 1: API key auth (ANTHROPIC_API_KEY) — simplest, no OAuth needed
    if [ "${CLAUDE_AUTH:-}" = "api-key" ] && [ -n "${CLAUDE_API_KEY:-}" ]; then
        # Claude Code reads ANTHROPIC_API_KEY from environment.
        # Write it to the profile so tmux sessions pick it up.
        local envfile="/home/dev/.claude_env"
        printf 'export ANTHROPIC_API_KEY="%s"\n' "$CLAUDE_API_KEY" > "$envfile"
        chmod 600 "$envfile"
        # Also add to bashrc if not already there
        if ! grep -q 'source.*\.claude_env' /home/dev/.bashrc 2>/dev/null; then
            printf '\n[ -f ~/.claude_env ] && source ~/.claude_env\n' >> /home/dev/.bashrc
        fi
        log "Claude API key configured (api-key auth)"
        return 0
    fi

    # Method 2: OAuth token from setup-token (oauth-token auth)
    # Uses CLAUDE_CODE_OAUTH_TOKEN env var — the officially supported way
    # for headless/CI auth with a Claude subscription.
    if [ "${CLAUDE_AUTH:-}" = "oauth-token" ] && [ -n "${CLAUDE_OAUTH_TOKEN:-}" ]; then
        local envfile="/home/dev/.claude_env"
        printf 'export CLAUDE_CODE_OAUTH_TOKEN="%s"\n' "$CLAUDE_OAUTH_TOKEN" > "$envfile"
        chmod 600 "$envfile"
        if ! grep -q 'source.*\.claude_env' /home/dev/.bashrc 2>/dev/null; then
            printf '\n[ -f ~/.claude_env ] && source ~/.claude_env\n' >> /home/dev/.bashrc
        fi
        log "Claude subscription token configured (CLAUDE_CODE_OAUTH_TOKEN)"
        return 0
    fi

    # Method 3: API key helper (api-key-helper auth) — for external secret managers
    if [ "${CLAUDE_AUTH:-}" = "api-key-helper" ] && [ -n "${CLAUDE_API_KEY:-}" ]; then
        # CLAUDE_API_KEY contains the helper command, not a literal key
        local envfile="/home/dev/.claude_env"
        printf 'export ANTHROPIC_API_KEY_HELPER="%s"\n' "$CLAUDE_API_KEY" > "$envfile"
        chmod 600 "$envfile"
        if ! grep -q 'source.*\.claude_env' /home/dev/.bashrc 2>/dev/null; then
            printf '\n[ -f ~/.claude_env ] && source ~/.claude_env\n' >> /home/dev/.bashrc
        fi
        log "Claude API key helper configured (api-key-helper auth)"
        return 0
    fi

    # Method 4: Fetch from metadata service (legacy / fallback)
    local resp
    resp=$(curl -sf --max-time 5 "${METADATA}/metadata/claude-credentials" 2>/dev/null || echo "")
    if [ -z "$resp" ]; then
        log "WARNING: no Claude credentials available (no config + metadata empty)"
        return 0
    fi

    # Validate response is JSON with expected fields
    if ! echo "$resp" | jq -e '.claudeAiOauth.refreshToken // .oauth_refresh_token' >/dev/null 2>&1; then
        log "WARNING: Claude credentials response missing token fields, skipping"
        return 0
    fi

    # If the metadata serves raw oauth fields, wrap into Claude Code's expected format
    if ! echo "$resp" | jq -e 'has("claudeAiOauth")' >/dev/null 2>&1; then
        resp=$(echo "$resp" | jq '{
            claudeAiOauth: {
                refreshToken: .oauth_refresh_token,
                accessToken: (.oauth_access_token // ""),
                expiresAt: (.oauth_expires_at // 0),
                scopes: (.oauth_scopes // ["user:inference","user:profile","user:sessions:claude_code"]),
                subscriptionType: (.oauth_subscription_type // ""),
                rateLimitTier: (.oauth_rate_limit_tier // "")
            }
        }' 2>/dev/null)
        if [ -z "$resp" ]; then
            log "WARNING: failed to transform Claude credentials, skipping"
            return 0
        fi
    fi

    echo "$resp" > "$cred_file"
    chmod 600 "$cred_file"
    log "Claude Code credentials installed from metadata"
}

clone_repo() {
    local repo="$1" target_dir="$2"
    if [ -d "$target_dir/.git" ]; then
        log "repo $repo already cloned at $target_dir, pulling latest"
        git -C "$target_dir" pull --ff-only 2>/dev/null || true
        return 0
    fi
    log "cloning $repo -> $target_dir"
    mkdir -p "$(dirname "$target_dir")"
    if git clone "https://github.com/${repo}.git" "$target_dir" 2>&1; then
        git -C "$target_dir" remote set-url origin "https://github.com/${repo}.git"
        log "cloned $repo"
    else
        log "WARNING: failed to clone $repo"
        return 1
    fi
}

install_persona() {
    local working_dir="$1"
    local persona_claude_md="$2"
    local persona_instructions="$3"
    local team_persona_files="$4"

    [ ! -d "$working_dir" ] && return

    local personas_dir="${working_dir}/.claude/personas"

    # Install persona file from repo path (e.g. ".claude/personas/dev.md")
    if [ -n "$persona_claude_md" ]; then
        local src="${working_dir}/${persona_claude_md}"
        if [ -f "$src" ]; then
            # Append inline instructions to the persona file if provided
            if [ -n "$persona_instructions" ]; then
                printf '\n\n## Additional Instructions\n\n%s\n' "$persona_instructions" >> "$src"
                log "appended inline instructions to $persona_claude_md"
            fi
            log "persona file verified at $persona_claude_md"
        else
            # Persona file doesn't exist yet — create it at the specified path
            mkdir -p "$(dirname "$src")"
            if [ -n "$persona_instructions" ]; then
                printf '# Agent Instructions\n\n%s\n' "$persona_instructions" > "$src"
            else
                touch "$src"
            fi
            log "created persona file at $persona_claude_md"
        fi
    elif [ -n "$persona_instructions" ]; then
        # No persona file path — create a default persona file
        mkdir -p "$personas_dir"
        printf '# Agent Instructions\n\n%s\n' "$persona_instructions" > "${personas_dir}/agent.md"
        log "created default persona at .claude/personas/agent.md"
    fi

    # Remove other agents' persona files (only files listed in team_persona_files)
    if [ -n "$team_persona_files" ]; then
        echo "$team_persona_files" | while IFS= read -r file; do
            [ -z "$file" ] && continue
            # Skip this agent's own persona file
            [ "$file" = "$persona_claude_md" ] && continue
            local target="${working_dir}/${file}"
            if [ -f "$target" ]; then
                rm "$target"
                log "removed other agent's persona: $file"
            fi
        done
    fi
}

restore_session() {
    local checkpoint
    checkpoint=$(curl -sf --max-time 10 "${METADATA}/tapegun/checkpoint" 2>/dev/null || echo "")
    if [ -z "$checkpoint" ] || [ "$checkpoint" = "null" ] || [ "$checkpoint" = "{}" ]; then
        return 1
    fi

    local session_id session_data git_branch
    session_id=$(echo "$checkpoint" | jq -r '.session_id // empty' 2>/dev/null)
    session_data=$(echo "$checkpoint" | jq -r '.session_data // empty' 2>/dev/null)
    git_branch=$(echo "$checkpoint" | jq -r '.git_branch // empty' 2>/dev/null)

    [ -z "$session_id" ] || [ -z "$session_data" ] && return 1

    log "restoring session $session_id"

    # Restore conversation history JSONL
    local session_dir="${CLAUDE_DIR}/projects/-home-dev-project"
    mkdir -p "$session_dir"
    echo "$session_data" > "${session_dir}/${session_id}.jsonl"
    log "session JSONL restored ($(echo "$session_data" | wc -c) bytes)"

    # Restore git branch if specified
    if [ -n "$git_branch" ] && [ -d "${PROJECT_DIR}/.git" ]; then
        cd "$PROJECT_DIR"
        git checkout "$git_branch" 2>/dev/null || git checkout -b "$git_branch" 2>/dev/null || true
        log "checked out branch $git_branch"
        cd - >/dev/null
    fi

    RESTORED_SESSION_ID="$session_id"
    return 0
}

checkpoint_session() {
    # Find the most recent session JSONL
    local session_dir="${CLAUDE_DIR}/projects/-home-dev-project"
    [ ! -d "$session_dir" ] && return

    local session_file
    session_file=$(ls -t "$session_dir"/*.jsonl 2>/dev/null | head -1)
    [ -z "$session_file" ] && return

    local session_id
    session_id=$(basename "$session_file" .jsonl)
    local size
    size=$(wc -c < "$session_file" 2>/dev/null || echo "0")

    # Skip if file is too large (>20MB) or empty
    [ "$size" -eq 0 ] && return
    [ "$size" -gt 20971520 ] && { log "WARNING: session too large for checkpoint ($size bytes)"; return; }

    # Capture git state
    local git_branch="" git_stash=""
    if [ -d "${PROJECT_DIR}/.git" ]; then
        git_branch=$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null || echo "")
        git_stash=$(git -C "$PROJECT_DIR" stash create 2>/dev/null || echo "")
    fi

    # POST checkpoint to metadata service
    if command -v jq >/dev/null 2>&1; then
        jq -n \
            --arg session_id "$session_id" \
            --arg git_branch "$git_branch" \
            --arg git_stash "$git_stash" \
            --rawfile session_data "$session_file" \
            '{session_id: $session_id, git_branch: $git_branch, git_stash: $git_stash, session_data: $session_data}' | \
        curl -sf -X POST "${METADATA}/tapegun/checkpoint" \
            -H "Content-Type: application/json" \
            -d @- \
            --max-time 15 2>/dev/null || true
    fi
}

setup_workspace() {
    # Idempotency: skip if already completed this boot
    if [ -f "$SETUP_STAMP" ]; then
        log "setup already completed this boot, skipping"
        return 0
    fi

    # Fetch agent config
    local agent_config
    agent_config=$(curl -sf --max-time 5 "${METADATA}/metadata/agent-config" 2>/dev/null || echo "")
    if [ -z "$agent_config" ] || [ "$agent_config" = "null" ] || [ "$agent_config" = "{}" ]; then
        log "no agent-config available, using defaults"
        # Still provision credentials even without agent-config
        setup_claude_credentials
        touch "$SETUP_STAMP"
        return 0
    fi

    log "agent config received"

    # Agent-config presence triggers autostart — the VM was configured by
    # team apply and should launch Claude Code automatically.
    AUTOSTART_CLAUDE=true

    # Parse tool and inference FIRST — credential setup depends on these
    local agent_tool_meta=$(echo "$agent_config" | jq -r '.tool // empty' 2>/dev/null)
    local agent_model_meta=$(echo "$agent_config" | jq -r '.inference.model // empty' 2>/dev/null)
    local inf_provider_meta=$(echo "$agent_config" | jq -r '.inference.provider // empty' 2>/dev/null)
    local inf_endpoint_meta=$(echo "$agent_config" | jq -r '.inference.endpoint // empty' 2>/dev/null)
    local inf_apikey_meta=$(echo "$agent_config" | jq -r '.inference.api_key // empty' 2>/dev/null)
    [ -n "$agent_tool_meta" ] && AGENT_TOOL="$agent_tool_meta"
    [ -n "$agent_model_meta" ] && AGENT_MODEL="$agent_model_meta"
    [ -n "$inf_provider_meta" ] && INFERENCE_PROVIDER="$inf_provider_meta"
    [ -n "$inf_endpoint_meta" ] && INFERENCE_ENDPOINT="$inf_endpoint_meta"
    [ -n "$inf_apikey_meta" ] && INFERENCE_API_KEY="$inf_apikey_meta"

    # Parse Claude auth config
    local claude_auth_meta=$(echo "$agent_config" | jq -r '.claude.auth // empty' 2>/dev/null)
    local claude_oauth_meta=$(echo "$agent_config" | jq -r '.claude.oauth_token // empty' 2>/dev/null)
    local claude_apikey_meta=$(echo "$agent_config" | jq -r '.claude.api_key // empty' 2>/dev/null)
    [ -n "$claude_auth_meta" ] && CLAUDE_AUTH="$claude_auth_meta"
    [ -n "$claude_oauth_meta" ] && CLAUDE_OAUTH_TOKEN="$claude_oauth_meta"
    [ -n "$claude_apikey_meta" ] && CLAUDE_API_KEY="$claude_apikey_meta"

    # Provision Claude credentials — must be in place before Claude Code launches
    setup_claude_credentials

    # Parse remaining config fields
    local repos persona_claude_md persona_instructions claude_flags claude_resume working_dir team_persona_files tapegun_sequences
    repos=$(echo "$agent_config" | jq -r '.repos // [] | .[]' 2>/dev/null)
    persona_claude_md=$(echo "$agent_config" | jq -r '.persona.claude_md // empty' 2>/dev/null)
    persona_instructions=$(echo "$agent_config" | jq -r '.persona.instructions // empty' 2>/dev/null)
    claude_flags=$(echo "$agent_config" | jq -r '.claude_flags // empty' 2>/dev/null)
    claude_resume=$(echo "$agent_config" | jq -r '.claude_resume // empty' 2>/dev/null)
    working_dir=$(echo "$agent_config" | jq -r '.working_dir // empty' 2>/dev/null)
    team_persona_files=$(echo "$agent_config" | jq -r '.team_persona_files // [] | .[]' 2>/dev/null)
    tapegun_sequences=$(echo "$agent_config" | jq -r '.tapegun // [] | .[]' 2>/dev/null)

    # Parse bootstrap commands
    local bootstrap_cmds
    bootstrap_cmds=$(echo "$agent_config" | jq -r '.bootstrap // [] | .[]' 2>/dev/null)

    # Parse plugins config
    local plugin_marketplaces plugin_installs
    plugin_marketplaces=$(echo "$agent_config" | jq -r '.plugins.marketplaces // [] | .[]' 2>/dev/null)
    plugin_installs=$(echo "$agent_config" | jq -r '.plugins.install // [] | .[]' 2>/dev/null)

    local repo_count
    repo_count=$(echo "$repos" | grep -c . || true)

    # Clone repos if specified
    if [ "$repo_count" -gt 0 ]; then
        setup_git_credentials

        if [ "$repo_count" -eq 1 ]; then
            local repo
            repo=$(echo "$repos" | head -1)
            clone_repo "$repo" "$PROJECT_DIR"
            [ -z "$working_dir" ] && working_dir="$PROJECT_DIR"
        else
            local first_repo=""
            while IFS= read -r repo; do
                [ -z "$repo" ] && continue
                local repo_name
                repo_name=$(basename "$repo")
                clone_repo "$repo" "${HOME_DIR}/projects/${repo_name}"
                [ -z "$first_repo" ] && first_repo="${HOME_DIR}/projects/${repo_name}"
            done <<< "$repos"
            if [ -n "$first_repo" ] && [ ! -e "$PROJECT_DIR" ]; then
                ln -sf "$first_repo" "$PROJECT_DIR"
                log "symlinked ~/project -> $first_repo"
            fi
            [ -z "$working_dir" ] && working_dir="$first_repo"
        fi
    fi

    # Wait for working directory (repo clone may be in progress from orchestrator)
    local target_dir="${working_dir:-$PROJECT_DIR}"
    if [ -n "$target_dir" ] && [ ! -d "$target_dir" ]; then
        log "waiting for $target_dir to appear..."
        for _i in $(seq 1 30); do
            [ -d "$target_dir" ] && break
            sleep 2
        done
    fi

    # Install persona files at .claude/personas/ path
