#!/bin/bash
# Tapegun agent communication daemon.
# Periodically captures tmux pane content and posts it to the metadata service.
# Checks for incoming messages and writes them to the inbox file.
# Messages with send_keys=true are also injected into tmux.

METADATA="http://169.254.169.254"
INBOX_DIR="/home/dev/.tapegun"
INBOX_FILE="${INBOX_DIR}/inbox.json"
CONFIG_FILE="${INBOX_DIR}/config"
POLL_INTERVAL=5

mkdir -p "$INBOX_DIR"

# --- Stop hook: notify metadata service on shutdown ---
cleanup() {
    echo "tapegun: shutting down, posting final status"
    curl -sf -X POST "${METADATA}/tapegun/activity" \
        -H "Content-Type: application/json" \
        -d '{"pane_content":"","status":"stopped"}' \
        --max-time 2 2>/dev/null || true
    exit 0
}
trap cleanup SIGTERM SIGINT

# --- Auto-start Claude Code under tmux ---
# Enabled by default (issue #62). Override via config file or metadata labels.
# Config file: /home/dev/.tapegun/config
# AUTOSTART_CLAUDE=false  # set to false to disable
# CLAUDE_FLAGS="--dangerously-skip-permissions"
# CLAUDE_RESUME=false
# CLAUDE_WORKING_DIR="/home/dev/project"
AUTOSTART_CLAUDE=true
CLAUDE_FLAGS="--dangerously-skip-permissions"
CLAUDE_RESUME=false
CLAUDE_WORKING_DIR="/home/dev/project"

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Also check metadata labels for autostart config (labels override defaults)
LABELS=$(curl -sf --max-time 2 "${METADATA}/identity" 2>/dev/null | jq -r '.labels // {} | to_entries[] | "\(.key)=\(.value)"' 2>/dev/null)
if echo "$LABELS" | grep -q "tapegun.autostart=false"; then
    AUTOSTART_CLAUDE=false
elif echo "$LABELS" | grep -q "tapegun.autostart=true"; then
    AUTOSTART_CLAUDE=true
fi
if echo "$LABELS" | grep -q "tapegun.resume=true"; then
    CLAUDE_RESUME=true
fi

if [ "$AUTOSTART_CLAUDE" = "true" ]; then
    echo "tapegun: auto-starting Claude Code under tmux"

    # Pre-trust the working directory so Claude doesn't prompt on first launch.
    # The --dangerously-skip-permissions flag handles tool permissions, but
    # Claude still prompts to trust the project directory on first use.
    if [ -n "$CLAUDE_WORKING_DIR" ]; then
        TRUST_DIR="$HOME/.claude"
        mkdir -p "$TRUST_DIR"
        # Write settings that pre-trust the working directory
        SETTINGS_FILE="$TRUST_DIR/settings.json"
        if [ ! -f "$SETTINGS_FILE" ]; then
            cat > "$SETTINGS_FILE" <<EOSETTINGS
{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "trustedDirectories": [
    "$CLAUDE_WORKING_DIR"
  ]
}
EOSETTINGS
            echo "tapegun: pre-trusted directory $CLAUDE_WORKING_DIR"
        fi
    fi

    # Create tmux session if not exists
    if ! tmux has-session -t main 2>/dev/null; then
        tmux new-session -d -s main
        sleep 1

        # Ensure PATH includes ~/.local/bin (where claude is installed via mise)
        tmux send-keys -t main 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' Enter
        sleep 0.5

        # Wait for working directory to appear (repo clone may still be in progress).
        # Polls every 2s for up to 30s, then proceeds without it.
        if [ -n "$CLAUDE_WORKING_DIR" ] && [ ! -d "$CLAUDE_WORKING_DIR" ]; then
            echo "tapegun: waiting for $CLAUDE_WORKING_DIR to appear..."
            for _i in $(seq 1 15); do
                [ -d "$CLAUDE_WORKING_DIR" ] && break
                sleep 2
            done
        fi

        if [ -n "$CLAUDE_WORKING_DIR" ] && [ -d "$CLAUDE_WORKING_DIR" ]; then
            tmux send-keys -t main "cd $CLAUDE_WORKING_DIR" Enter
            sleep 0.5
        fi

        # Start Claude Code
        CLAUDE_CMD="claude"
        [ -n "$CLAUDE_FLAGS" ] && CLAUDE_CMD="$CLAUDE_CMD $CLAUDE_FLAGS"
        [ "$CLAUDE_RESUME" = "true" ] && CLAUDE_CMD="$CLAUDE_CMD --resume"
        tmux send-keys -t main "$CLAUDE_CMD" Enter
        echo "tapegun: Claude Code started (flags: $CLAUDE_FLAGS, resume: $CLAUDE_RESUME)"
    else
        echo "tapegun: tmux session 'main' already exists, skipping autostart"
    fi
fi

# Wait for metadata service
for i in $(seq 1 30); do
  if curl -sf -o /dev/null --max-time 2 "${METADATA}/identity" 2>/dev/null; then
    break
  fi
  [ "$i" -eq 30 ] && { echo "tapegun: metadata service not reachable"; exit 1; }
  sleep 1
done

echo "tapegun: daemon started (poll every ${POLL_INTERVAL}s)"

# tmux command — runs as the dev user (service runs as User=dev)
TMUX_CMD="tmux"

# --- Health check function ---
run_health_checks() {
    local binary_exec=false
    local network=false
    local metadata=false
    local disk=false
    local services=false
    local health="unhealthy"
    local details=""

    # Check 1: binary execution
    if /bin/true 2>/dev/null; then
        binary_exec=true
    fi

    # Check 2: network connectivity (gateway)
    if ping -c1 -W2 10.0.0.1 >/dev/null 2>&1; then
        network=true
    fi

    # Check 3: metadata service reachable
    if curl -sf --max-time 2 "${METADATA}/identity" >/dev/null 2>&1; then
        metadata=true
    fi

    # Check 4: disk readable
    if test -r /etc/os-release 2>/dev/null; then
        disk=true
    fi

    # Check 5: key services running (ssh, tapegun — tapegun is us, so just ssh)
    if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
        services=true
    fi

    # Determine overall health
    if $binary_exec && $network && $metadata && $disk && $services; then
        health="healthy"
    elif $binary_exec && $disk; then
        health="degraded"
    fi

    # Build JSON
    if command -v jq >/dev/null 2>&1; then
        jq -n \
            --arg health "$health" \
            --argjson binary_exec "$binary_exec" \
            --argjson network "$network" \
            --argjson metadata "$metadata" \
            --argjson disk "$disk" \
            --argjson services "$services" \
            '{health: $health, health_checks: {binary_exec: $binary_exec, network: $network, metadata: $metadata, disk: $disk, services: $services}}'
    else
        cat <<EOJSON
{"health":"${health}","health_checks":{"binary_exec":${binary_exec},"network":${network},"metadata":${metadata},"disk":${disk},"services":${services}}}
EOJSON
    fi
}

while true; do
    # --- Post health ---
    HEALTH_PAYLOAD=$(run_health_checks)
    curl -sf -X POST "${METADATA}/tapegun/health" \
        -H "Content-Type: application/json" \
        -d "$HEALTH_PAYLOAD" \
        2>/dev/null || true

    # --- Post activity ---
    if $TMUX_CMD has-session 2>/dev/null; then
        PANE_CONTENT=$($TMUX_CMD capture-pane -p -t 0 2>/dev/null | tail -50)
        if [ -n "$PANE_CONTENT" ]; then
            STATUS="active"
        else
            STATUS="idle"
        fi
        # Build JSON payload — use jq for safe escaping
        if command -v jq >/dev/null 2>&1; then
            PAYLOAD=$(jq -n \
                --arg content "$PANE_CONTENT" \
                --arg status "$STATUS" \
                '{pane_content: $content, status: $status}')
        else
            # Fallback: Python for JSON escaping
            PAYLOAD=$(python3 -c "
import json, sys
print(json.dumps({'pane_content': sys.stdin.read(), 'status': '$STATUS'}))" <<< "$PANE_CONTENT")
        fi
        curl -sf -X POST "${METADATA}/tapegun/activity" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD" \
            2>/dev/null || true
    fi

    # --- Check inbox ---
    MSGS=$(curl -sf "${METADATA}/tapegun/inbox" 2>/dev/null)
    if [ -n "$MSGS" ] && [ "$MSGS" != "[]" ] && [ "$MSGS" != "null" ]; then
        # Append to inbox file (create if missing)
        if [ -f "$INBOX_FILE" ]; then
            # Merge new messages into existing array
            if command -v jq >/dev/null 2>&1; then
                jq -s '.[0] + .[1]' "$INBOX_FILE" <(echo "$MSGS") > "${INBOX_FILE}.tmp" \
                    && mv "${INBOX_FILE}.tmp" "$INBOX_FILE"
            else
                echo "$MSGS" > "$INBOX_FILE"
            fi
        else
            echo "$MSGS" > "$INBOX_FILE"
        fi
        chmod 644 "$INBOX_FILE"

        # Inject send_keys messages into tmux.
        # By default, Enter is sent after the text (auto-submit).
        # Messages with no_enter=true paste text without pressing Enter.
        if command -v jq >/dev/null 2>&1 && $TMUX_CMD has-session 2>/dev/null; then
            echo "$MSGS" | jq -c '.[] | select(.send_keys == true or .priority == "urgent")' | while IFS= read -r msg_obj; do
                line=$(echo "$msg_obj" | jq -r '.body')
                no_enter=$(echo "$msg_obj" | jq -r '.no_enter // false')
                if [ -n "$line" ]; then
                    if [ "$no_enter" = "true" ]; then
                        $TMUX_CMD send-keys -t 0 "$line"
                    else
                        $TMUX_CMD send-keys -t 0 "$line" Enter
                    fi
                fi
            done
        fi
    fi

    sleep "$POLL_INTERVAL"
done
