[Unit]
Description=Tapegun agent communication daemon
After=network-online.target boxcutter-metadata.service opt-boxcutter-tools.automount
Wants=network-online.target
Requires=opt-boxcutter-tools.automount

[Service]
Type=simple
User=dev
Group=dev
ExecStart=/usr/local/bin/boxcutter-tapegun
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
